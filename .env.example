# frontend/.env.example
# ──────────────────────────────────────────────────────────────
# Environment Variables for Vercel Deployment
# Set these in Vercel Dashboard → Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────

# Backend API URL (Render) — no trailing slash
# This is injected into env-config.js at build time via Vercel Build Command:
#   echo "window.ENV={API_BASE:'$API_BASE'};" > env-config.js
API_BASE=https://video-downloader-backend-1-5oer.onrender.com/api

# ──────────────────────────────────────────────────────────────
# For local development, edit env-config.js directly:
#   window.ENV = { API_BASE: "http://127.0.0.1:5000/api" };
# ──────────────────────────────────────────────────────────────
